{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neoacc-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "ORDERS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ALLOW_DEV_AUTH": "0"
  }
}
